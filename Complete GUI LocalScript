local function refreshESP(tagName, enabled)
    for object, highlight in pairs(highlights) do
        if highlight:GetAttribute("TagName") == tagName then
            highlight:Destroy()
            highlights[object] = nil
        end
    end

    if not enabled then
        return
    end

    for _, object in ipairs(CollectionService:GetTagged(tagName)) do
        if object:IsA("BasePart") or object:IsA("Model") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "DexterESP"
            highlight.Adornee = object
            highlight.FillColor = COLORS.Accent
            highlight.OutlineColor = Color3.new(1, 1, 1)
            highlight.FillTransparency = 0.65
            highlight:SetAttribute("TagName", tagName)
            highlight.Parent = object
            highlights[object] = highlight
        end
    end
end

