        AutoButtonColor = true,
        LayoutOrder = order or 1,
    }, parent)

    corner(button, 9)

    create("UIPadding", {
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 10),
    }, button)

    button.Activated:Connect(callback)
    return button
end

local function addSection(parent, text, order)
    local section = makeLabel(
        parent,
        text,
        UDim2.new(1, 0, 0, 24),
        UDim2.new(),
        12,
        COLORS.Muted
    )
    section.Font = Enum.Font.GothamBold
    section.LayoutOrder = order or 1
    return section
end

local function refreshToggle(feature)
    local button = toggleButtons[feature]
    if not button then
        return
    end

    local titleText = button:GetAttribute("LabelText") or feature
    local enabled = state[feature]

    button.Text = titleText .. "     " .. (enabled and "ON" or "OFF")
    button.BackgroundColor3 = enabled
        and COLORS.AccentDark
        or COLORS.Button
end

local function addAutomationToggle(parent, feature, titleText, order)
    local button = addButton(parent, titleText, function()
        state[feature] = not state[feature]
        refreshToggle(feature)
        SetAutomation:FireServer(feature, state[feature])
    end, order)

    button:SetAttribute("LabelText", titleText)
    toggleButtons[feature] = button
    refreshToggle(feature)
    return button
end

