local function addButton(parent, text, callback, order)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = COLORS.Button,
        Text = text,
        TextColor3 = COLORS.Text,
        TextSize = 13,
