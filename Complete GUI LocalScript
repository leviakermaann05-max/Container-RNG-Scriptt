local function onTaggedAdded(tagName, object, enabled)
    if not enabled then
        return
    end

    if not (object:IsA("BasePart") or object:IsA("Model")) then
        return
    end

    if highlights[object] then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "DexterESP"
    highlight.Adornee = object
    highlight.FillColor = COLORS.Accent
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.65
    highlight:SetAttribute("TagName", tagName)
    highlight.Parent = object
    highlights[object] = highlight
end

CollectionService:GetInstanceAddedSignal("CNRG_Loot"):Connect(function(object)
    onTaggedAdded("CNRG_Loot", object, state.LootESP)
end)

CollectionService:GetInstanceAddedSignal("CNRG_Container"):Connect(function(object)
    onTaggedAdded("CNRG_Container", object, state.ContainerESP)
end)

CollectionService:GetInstanceRemovedSignal("CNRG_Loot"):Connect(function(object)
    local highlight = highlights[object]
    if highlight and highlight:GetAttribute("TagName") == "CNRG_Loot" then
        highlight:Destroy()
        highlights[object] = nil
    end
end)

CollectionService:GetInstanceRemovedSignal("CNRG_Container"):Connect(function(object)
