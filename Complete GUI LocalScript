local function showPage(name)
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(tabs) do
        button.BackgroundColor3 = tabName == name
            and COLORS.AccentDark
            or COLORS.Button
